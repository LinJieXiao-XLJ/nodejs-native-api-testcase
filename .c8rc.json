{
  "all": true,
  "src": "lib/@iotdb/client",
  "exclude": [
    "**/thrift/**",
    "**/*.d.ts",
    "**/*.js.map",
    "tests/**",
    "node_modules/**",
    "coverage/**"
  ],
  "reporter": ["text", "text-summary", "html", "lcov"],
  "reportsDir": "coverage",
  "watermarks": {
    "lines": [40, 70],
    "functions": [35, 65],
    "branches": [45, 75],
    "statements": [40, 70]
  }
}
